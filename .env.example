# X (Twitter) API v2 bearer token (https://developer.x.com/en/portal/dashboard)
TWITTER_BEARER_TOKEN=

# The account to watch, without the leading @
TWITTER_WATCHED_USERNAME=

# Your own handle; a notification is sent whenever the watched account tags it
TWITTER_MY_USERNAME=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat that receives notifications (your user id, or a group/channel id)
TELEGRAM_CHAT_ID=

# Optional settings
POLL_INTERVAL_SECONDS=300
INCLUDE_RETWEETS=false
INCLUDE_REPLIES=true
STATE_FILE=state.json
LOG_LEVEL=INFO
