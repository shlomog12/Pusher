# Which implementation loads the tweets: "api" (official X API) or "scraper" (X website)
TWEET_SOURCE=api

# The account to watch, without the leading @
TWITTER_WATCHED_USERNAME=

# Comma-separated accounts; a notification is sent whenever the watched account
# tags one of them. Defaults to TWITTER_MY_USERNAME.
TWITTER_MENTIONED_USERNAMES=

# Your own handle
TWITTER_MY_USERNAME=
# Also forward every tweet you post (needs TWITTER_MY_USERNAME)
FORWARD_MY_TWEETS=false
# With FORWARD_MY_TWEETS, also forward your retweets
FORWARD_MY_RETWEETS=false

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat that receives notifications (your user id, or a group/channel id)
TELEGRAM_CHAT_ID=

# --- TWEET_SOURCE=api ---
# X API v2 bearer token (https://developer.x.com/en/portal/dashboard)
TWITTER_BEARER_TOKEN=

# --- TWEET_SOURCE=scraper ---
# "auth_token" cookie of a logged-in x.com session (browser dev tools > Application > Cookies)
X_AUTH_TOKEN=
# Optional "ct0" cookie from the same session
X_CT0=
SCRAPER_HEADLESS=true
# How many times to scroll the profile to load more tweets per check
SCRAPER_SCROLLS=2
SCRAPER_TIMEOUT_SECONDS=45
# Optional path to a Chrome/Chromium binary instead of Playwright's bundled one
SCRAPER_BROWSER_PATH=

# --- Optional settings ---
POLL_INTERVAL_SECONDS=300
INCLUDE_RETWEETS=false
INCLUDE_REPLIES=false
STATE_FILE=state.json
LOG_LEVEL=INFO
